{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stayhub.local/contracts/booking-payment-events-v1.schema.json",
  "title": "StayHub Booking Events v1",
  "description": "Eventos propios de Bookings. Los eventos de Payments se validan contra el contrato real del productor en specs/003-reservas-pagos-resenas/payments_service/contracts/payment-events-v1.schema.json.",
  "oneOf": [
    { "$ref": "#/$defs/bookingCreated" },
    { "$ref": "#/$defs/bookingConfirmed" },
    { "$ref": "#/$defs/bookingCancelled" },
    { "$ref": "#/$defs/bookingCompleted" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^\\d{1,10}(\\.\\d{2})$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "bookingCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "bookingId", "guestId", "ownerId", "propertyId", "roomId", "checkIn", "checkOut", "total", "status"],
      "properties": {
        "eventId": { "$ref": "#/$defs/uuid" },
        "eventType": { "const": "booking.v1.created" },
        "schemaVersion": { "const": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "bookingId": { "$ref": "#/$defs/uuid" },
        "traceId": { "$ref": "#/$defs/traceId" },
        "guestId": { "$ref": "#/$defs/uuid" },
        "ownerId": { "$ref": "#/$defs/uuid" },
        "propertyId": { "$ref": "#/$defs/uuid" },
        "roomId": { "$ref": "#/$defs/uuid" },
        "checkIn": { "type": "string", "format": "date" },
        "checkOut": { "type": "string", "format": "date" },
        "total": { "$ref": "#/$defs/money" },
        "status": { "const": "PENDING_PAYMENT" }
      }
    },
    "bookingConfirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "bookingId", "guestId", "propertyName", "roomName", "checkIn", "checkOut", "guests", "totalPrice", "checkInAt"],
      "properties": {
        "eventId": { "$ref": "#/$defs/uuid" },
        "eventType": { "const": "booking.v1.confirmed" },
        "schemaVersion": { "const": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "bookingId": { "$ref": "#/$defs/uuid" },
        "traceId": { "$ref": "#/$defs/traceId" },
        "guestId": { "$ref": "#/$defs/uuid" },
        "propertyName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roomName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "checkIn": { "type": "string", "format": "date" },
        "checkOut": { "type": "string", "format": "date" },
        "guests": { "type": "integer", "minimum": 1, "maximum": 100 },
        "totalPrice": { "type": "string", "pattern": "^\\d{1,10}(\\.\\d{2})$" },
        "checkInAt": { "type": "string", "format": "date-time" }
      }
    },
    "bookingCancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "bookingId", "cancelledBy"],
      "properties": {
        "eventId": { "$ref": "#/$defs/uuid" },
        "eventType": { "const": "booking.v1.cancelled" },
        "schemaVersion": { "const": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "bookingId": { "$ref": "#/$defs/uuid" },
        "traceId": { "$ref": "#/$defs/traceId" },
        "cancelledBy": { "enum": ["GUEST", "OWNER"] }
      }
    },
    "bookingCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "bookingId", "guestId", "propertyId"],
      "properties": {
        "eventId": { "$ref": "#/$defs/uuid" },
        "eventType": { "const": "booking.v1.completed" },
        "schemaVersion": { "const": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "bookingId": { "$ref": "#/$defs/uuid" },
        "traceId": { "$ref": "#/$defs/traceId" },
        "guestId": { "$ref": "#/$defs/uuid" },
        "propertyId": { "$ref": "#/$defs/uuid" }
      }
    }
  }
}
