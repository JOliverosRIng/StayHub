{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stayhub.local/contracts/search-projection-events-v1.schema.json",
  "title": "StayHub Search Projection Events v1",
  "oneOf": [
    { "$ref": "#/$defs/upserted" },
    { "$ref": "#/$defs/removed" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "accommodationId", "projectionVersion"],
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "eventType": { "type": "string" },
        "schemaVersion": { "const": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "accommodationId": { "type": "string", "format": "uuid" },
        "projectionVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "availabilityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "availableCapacity"],
      "properties": {
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "availableCapacity": { "type": "integer", "minimum": 1 }
      }
    },
    "upserted": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "accommodationId", "projectionVersion", "data"],
          "properties": {
            "eventId": { "type": "string", "format": "uuid" },
            "eventType": { "const": "accommodation.search.v1.upserted" },
            "schemaVersion": { "const": 1 },
            "occurredAt": { "type": "string", "format": "date-time" },
            "accommodationId": { "type": "string", "format": "uuid" },
            "projectionVersion": { "type": "integer", "minimum": 1 },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["published", "name", "description", "countryCode", "city", "minNightlyPrice", "currency", "capacity", "amenities", "keywords", "availability", "sourceUpdatedAt"],
              "properties": {
                "published": { "type": "boolean" },
                "name": { "type": "string", "minLength": 1, "maxLength": 160 },
                "description": { "type": "string", "maxLength": 5000 },
                "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
                "region": { "type": ["string", "null"], "maxLength": 120 },
                "city": { "type": "string", "minLength": 1, "maxLength": 120 },
                "addressSummary": { "type": ["string", "null"], "maxLength": 240 },
                "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
                "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
                "minNightlyPrice": { "type": "number", "minimum": 0 },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "capacity": { "type": "integer", "minimum": 1 },
                "amenities": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
                "keywords": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
                "primaryPhotoUrl": { "type": ["string", "null"], "format": "uri" },
                "availability": { "type": "array", "maxItems": 366, "items": { "$ref": "#/$defs/availabilityWindow" } },
                "sourceUpdatedAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ]
    },
    "removed": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "accommodationId", "projectionVersion"],
          "properties": {
            "eventId": { "type": "string", "format": "uuid" },
            "eventType": { "const": "accommodation.search.v1.removed" },
            "schemaVersion": { "const": 1 },
            "occurredAt": { "type": "string", "format": "date-time" },
            "accommodationId": { "type": "string", "format": "uuid" },
            "projectionVersion": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
