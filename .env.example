# Auth service
AUTH_PORT=3001
AUTH_DATABASE_URL=postgresql://stayhub_auth:change-me@auth-db:5432/auth_db?schema=public
AUTH_REDIS_URL=redis://:change-me@auth-redis:6379/0
AUTH_REDIS_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me

# Argon2id
AUTH_ARGON2_MEMORY_COST=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=1

# User access JWT (PEM values are injected as secrets in real environments)
AUTH_JWT_ACTIVE_KID=stayhub-auth-2026-01
AUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----
AUTH_JWT_PUBLIC_KEYS_JSON={"stayhub-auth-2026-01":"-----BEGIN PUBLIC KEY-----\\nreplace-me\\n-----END PUBLIC KEY-----"}
AUTH_JWT_ISSUER=https://auth.stayhub.internal
AUTH_JWT_AUDIENCE=stayhub-api

# Gateway -> Auth service JWT
AUTH_INBOUND_SERVICE_PUBLIC_KEYS_JSON={"gateway-2026-01":"-----BEGIN PUBLIC KEY-----\\nreplace-me\\n-----END PUBLIC KEY-----"}
AUTH_INBOUND_SERVICE_ISSUER=stayhub-api-gateway
AUTH_INBOUND_SERVICE_AUDIENCE=stayhub-auth-service
AUTH_INBOUND_SERVICE_SCOPE=auth:invoke

# Auth -> Users service JWT
USERS_SERVICE_URL=http://users-service:3002
AUTH_OUTBOUND_SERVICE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----
AUTH_OUTBOUND_SERVICE_KID=auth-users-2026-01
AUTH_OUTBOUND_SERVICE_ISSUER=stayhub-auth-service
AUTH_OUTBOUND_SERVICE_AUDIENCE=stayhub-users-service
AUTH_OUTBOUND_SERVICE_SCOPE=users:identity
AUTH_OUTBOUND_SERVICE_TTL_SECONDS=60

# Session and safe hashing secrets
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_REFRESH_TOKEN_HMAC_SECRET=replace-with-at-least-32-characters
AUTH_REGISTRATION_FINGERPRINT_SECRET=replace-with-at-least-32-characters
AUTH_LOGIN_IDENTIFIER_HMAC_SECRET=replace-with-at-least-32-characters

# Registration reconciler
AUTH_RECONCILER_INTERVAL_SECONDS=30
AUTH_RECONCILER_TTL_SECONDS=900
AUTH_RECONCILER_BATCH_SIZE=50
AUTH_RECONCILER_MAX_ATTEMPTS=5

# Dependencies and telemetry
AUTH_USERS_TIMEOUT_MS=3000
AUTH_USERS_CIRCUIT_FAILURE_THRESHOLD=5
AUTH_USERS_CIRCUIT_RESET_MS=30000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=stayhub-auth-service
NODE_ENV=development

# Swagger UI (solo development). Servidor que usa "Try it out".
# Vacío o relativo "/" evita CORS al abrir la UI desde el mismo origen.
AUTH_SWAGGER_SERVER_URL=/

