# Users service (Grupo 2). Example values only; never commit real secrets.
USERS_PORT=3002
USERS_DB_PASSWORD=change-me
USERS_DATABASE_URL=postgresql://stayhub_users:change-me@users-db:5432/users_db?schema=public

# User access JWT issued by auth-service (public keys only, keyed by kid)
USERS_JWT_PUBLIC_KEYS_JSON={"stayhub-auth-2026-01":"-----BEGIN PUBLIC KEY-----\\nreplace-me\\n-----END PUBLIC KEY-----"}
USERS_JWT_ISSUER=https://auth.stayhub.internal
USERS_JWT_AUDIENCE=stayhub-api

# Inbound service JWT (auth-service -> users-service)
USERS_SERVICE_AUTH_PUBLIC_KEYS_JSON={"auth-users-2026-01":"-----BEGIN PUBLIC KEY-----\\nreplace-me\\n-----END PUBLIC KEY-----"}
USERS_SERVICE_AUTH_ISSUER=stayhub-auth-service
USERS_SERVICE_AUTH_AUDIENCE=stayhub-users-service
USERS_SERVICE_AUTH_REGISTRATION_SCOPE=users:registrations
USERS_SERVICE_AUTH_LOOKUP_SCOPE=users:login-identities

# Profile photo upload limit (exactly 5,000,000 bytes)
USERS_MAX_PHOTO_BYTES=5000000

# Telemetry
USERS_OTLP_ENDPOINT=http://otel-collector:4318
USERS_OTEL_SERVICE_NAME=stayhub-users-service
NODE_ENV=development
