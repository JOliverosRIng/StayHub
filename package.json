{
  "name": "stayhub",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/accommodations-service",
    "apps/api-gateway",
    "apps/auth-service",
    "apps/users-service",
    "apps/search-service",
    "apps/bookings-service",
    "apps/reviews-service",
    "apps/web",
    "apps/payments-service"
  ],
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "npm run build:gateway && npm run build:auth && npm run build:users && npm run build:search && npm run build:bookings && npm run build:reviews && npm run build:web",
    "lint": "npm run lint:gateway && npm run lint:auth && npm run lint:users && npm run lint:search && npm run lint:bookings && npm run lint:reviews && npm run lint:web",
    "typecheck": "npm run typecheck:gateway && npm run typecheck:auth && npm run typecheck:users && npm run typecheck:search && npm run typecheck:bookings && npm run typecheck:reviews && npm run typecheck:web",
    "test": "npm run test:gateway && npm run test:auth && npm run test:users && npm run test:search && npm run test:bookings && npm run test:reviews && npm run test:web",
    "build:gateway": "npm run build --workspace @stayhub/api-gateway",
    "lint:gateway": "npm run lint --workspace @stayhub/api-gateway",
    "typecheck:gateway": "npm run typecheck --workspace @stayhub/api-gateway",
    "test:gateway": "npm run test --workspace @stayhub/api-gateway",
    "test:gateway:unit": "npm run test:unit --workspace @stayhub/api-gateway",
    "test:gateway:integration": "npm run test:integration --workspace @stayhub/api-gateway",
    "test:gateway:contract": "npm run test:contract --workspace @stayhub/api-gateway",
    "test:gateway:security": "npm run test:security --workspace @stayhub/api-gateway",
    "test:gateway:coverage": "npm run test:coverage --workspace @stayhub/api-gateway",
    "test:gateway:reviews:e2e": "npm run test:e2e --workspace @stayhub/api-gateway -- test/e2e/gateway-reviews-real.e2e-spec.ts",
    "test:gateway:bookings:e2e": "npm run test:e2e --workspace @stayhub/bookings-service -- test/e2e/gateway-bookings.e2e-spec.ts",
    "openapi:check:gateway": "node scripts/check-public-openapi-syntax.mjs && node scripts/validate-public-openapi.mjs",
    "dev:gateway": "node scripts/dev-gateway.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "smoke:local": "node scripts/dev-smoke.mjs",
    "build:auth": "npm run build --workspace @stayhub/auth-service",
    "lint:auth": "npm run lint --workspace @stayhub/auth-service",
    "typecheck:auth": "npm run typecheck --workspace @stayhub/auth-service",
    "test:auth": "npm run test --workspace @stayhub/auth-service",
    "test:auth:unit": "npm run test:unit --workspace @stayhub/auth-service",
    "test:auth:integration": "npm run test:integration --workspace @stayhub/auth-service",
    "test:auth:contract": "npm run test:contract --workspace @stayhub/auth-service",
    "test:auth:security": "npm run test:security --workspace @stayhub/auth-service",
    "test:auth:cross-service": "npm run test:cross-service --workspace @stayhub/auth-service",
    "test:auth:coverage": "npm run test:coverage --workspace @stayhub/auth-service",
    "test:auth-users": "npm run test:auth-users --workspace @stayhub/auth-service",
    "openapi:auth:check": "node scripts/check-auth-openapi-syntax.mjs && npm run test:contract --workspace @stayhub/auth-service -- --runTestsByPath test/contract/openapi-drift.spec.ts",
    "dev:swagger": "node scripts/dev-auth-swagger.mjs",
    "dev:swagger:docker": "node scripts/dev-auth-swagger.mjs --service-container",
    "env:auth:dev": "node scripts/generate-auth-dev-env.mjs",
    "env:compose:dev": "node scripts/generate-compose-dev-env.mjs",
    "prisma:auth:generate": "npm run prisma:generate --workspace @stayhub/auth-service",
    "prisma:auth:migrate:dev": "npm run prisma:migrate:dev --workspace @stayhub/auth-service",
    "prisma:auth:migrate:deploy": "npm run prisma:migrate:deploy --workspace @stayhub/auth-service",
    "build:users": "npm run build --workspace @stayhub/users-service",
    "lint:users": "npm run lint --workspace @stayhub/users-service",
    "typecheck:users": "npm run typecheck --workspace @stayhub/users-service",
    "test:users": "npm run test --workspace @stayhub/users-service",
    "test:users:unit": "npm run test:unit --workspace @stayhub/users-service",
    "test:users:integration": "npm run test:integration --workspace @stayhub/users-service",
    "test:users:contract": "npm run test:contract --workspace @stayhub/users-service",
    "test:users:security": "npm run test:security --workspace @stayhub/users-service",
    "prisma:users:generate": "npm run prisma:generate --workspace @stayhub/users-service",
    "prisma:users:migrate:dev": "npm run prisma:migrate:dev --workspace @stayhub/users-service",
    "prisma:users:migrate:deploy": "npm run prisma:migrate:deploy --workspace @stayhub/users-service",
    "build:search": "npm run build --workspace @stayhub/search-service",
    "env:search:dev": "node scripts/generate-search-dev-env.mjs",
    "token:search:dev": "node scripts/generate-search-dev-token.mjs",
    "dev:search:up": "npm run env:search:dev && podman-compose --env-file .env.search -f docker-compose.search.yml up -d",
    "dev:search:down": "podman-compose --env-file .env.search -f docker-compose.search.yml down",
    "lint:search": "npm run lint --workspace @stayhub/search-service",
    "typecheck:search": "npm run typecheck --workspace @stayhub/search-service",
    "test:search": "npm run test --workspace @stayhub/search-service",
    "test:search:unit": "npm run test:unit --workspace @stayhub/search-service",
    "test:search:integration": "npm run test:integration --workspace @stayhub/search-service",
    "test:search:contract": "npm run test:contract --workspace @stayhub/search-service",
    "test:search:security": "npm run test:security --workspace @stayhub/search-service",
    "test:search:performance": "npm run test:performance --workspace @stayhub/search-service",
    "prisma:search:generate": "npm run prisma:generate --workspace @stayhub/search-service",
    "prisma:search:migrate:dev": "npm run prisma:migrate:dev --workspace @stayhub/search-service",
    "prisma:search:migrate:deploy": "npm run prisma:migrate:deploy --workspace @stayhub/search-service",
    "build:bookings": "npm run build --workspace @stayhub/bookings-service",
    "lint:bookings": "npm run lint --workspace @stayhub/bookings-service",
    "typecheck:bookings": "npm run typecheck --workspace @stayhub/bookings-service",
    "test:bookings": "npm run test --workspace @stayhub/bookings-service",
    "test:bookings:unit": "npm run test:unit --workspace @stayhub/bookings-service",
    "test:bookings:integration": "npm run test:integration --workspace @stayhub/bookings-service",
    "test:bookings:contract": "npm run test:contract --workspace @stayhub/bookings-service",
    "test:bookings:security": "npm run test:security --workspace @stayhub/bookings-service",
    "test:bookings:concurrency": "npm run test:concurrency --workspace @stayhub/bookings-service",
    "prisma:bookings:generate": "npm run prisma:generate --workspace @stayhub/bookings-service",
    "prisma:bookings:migrate:deploy": "npm run prisma:migrate:deploy --workspace @stayhub/bookings-service",
    "openapi:bookings:check": "node scripts/validate-bookings-contracts.mjs && npm run test:bookings:contract -- --runTestsByPath test/contract/openapi-drift.spec.ts",
    "build:accommodations": "npm run build --workspace @stayhub/accommodations-service",
    "lint:accommodations": "npm run lint --workspace @stayhub/accommodations-service",
    "typecheck:accommodations": "npm run typecheck --workspace @stayhub/accommodations-service",
    "test:accommodations": "npm run test --workspace @stayhub/accommodations-service",
    "test:accommodations:unit": "npm run test:unit --workspace @stayhub/accommodations-service",
    "test:accommodations:integration": "npm run test:integration --workspace @stayhub/accommodations-service",
    "test:accommodations:contract": "npm run test:contract --workspace @stayhub/accommodations-service",
    "test:accommodations:security": "npm run test:security --workspace @stayhub/accommodations-service",
    "test:accommodations:coverage": "npm run test:coverage --workspace @stayhub/accommodations-service",
    "prisma:accommodations:generate": "npm run prisma:generate --workspace @stayhub/accommodations-service",
    "prisma:accommodations:migrate:deploy": "npm run prisma:migrate:deploy --workspace @stayhub/accommodations-service",
    "openapi:accommodations:check": "npm run openapi:check --workspace @stayhub/accommodations-service",
    "build:reviews": "npm run build --workspace @stayhub/reviews-service",
    "lint:reviews": "npm run lint --workspace @stayhub/reviews-service",
    "typecheck:reviews": "npm run typecheck --workspace @stayhub/reviews-service",
    "test:reviews": "npm run test --workspace @stayhub/reviews-service",
    "test:reviews:unit": "npm run test:unit --workspace @stayhub/reviews-service",
    "test:reviews:integration": "npm run test:integration --workspace @stayhub/reviews-service",
    "test:reviews:contract": "npm run test:contract --workspace @stayhub/reviews-service",
    "test:reviews:security": "npm run test:security --workspace @stayhub/reviews-service",
    "test:reviews:concurrency": "npm run test:concurrency --workspace @stayhub/reviews-service",
    "test:reviews:performance": "npm run test:performance --workspace @stayhub/reviews-service",
    "test:reviews:e2e": "npm run test:e2e --workspace @stayhub/reviews-service",
    "test:reviews:coverage": "npm run test:coverage --workspace @stayhub/reviews-service",
    "prisma:reviews:generate": "npm run prisma:generate --workspace @stayhub/reviews-service",
    "prisma:reviews:migrate:deploy": "npm run prisma:migrate:deploy --workspace @stayhub/reviews-service",
    "openapi:reviews:check": "node scripts/validate-reviews-contracts.mjs && npm run test:reviews:contract -- --runTestsByPath test/contract/openapi-drift.spec.ts",
    "build:payments": "npm run build --workspace @stayhub/payments-service",
    "lint:payments": "npm run lint --workspace @stayhub/payments-service",
    "typecheck:payments": "npm run typecheck --workspace @stayhub/payments-service",
    "test:payments": "npm run test --workspace @stayhub/payments-service",
    "test:payments:unit": "npm run test:unit --workspace @stayhub/payments-service",
    "test:payments:integration": "npm run test:integration --workspace @stayhub/payments-service",
    "test:payments:contract": "npm run test:contract --workspace @stayhub/payments-service",
    "test:payments:security": "npm run test:security --workspace @stayhub/payments-service",
    "test:payments:performance": "npm run test:performance --workspace @stayhub/payments-service",
    "test:payments:coverage": "npm run test:coverage --workspace @stayhub/payments-service",
    "openapi:payments:check": "node scripts/validate-payments-openapi.mjs",
    "prisma:payments:generate": "npm run prisma:generate --workspace @stayhub/payments-service",
    "prisma:payments:migrate:dev": "npm run prisma:migrate:dev --workspace @stayhub/payments-service",
    "prisma:payments:migrate:deploy": "npm run prisma:migrate:deploy --workspace @stayhub/payments-service",
    "build:web": "npm run build --workspace @stayhub/web",
    "lint:web": "npm run lint --workspace @stayhub/web",
    "typecheck:web": "npm run typecheck --workspace @stayhub/web",
    "test:web": "npm run test --workspace @stayhub/web",
    "dev:web": "npm run dev --workspace @stayhub/web",
    "env:web:https": "node scripts/setup-web-https.mjs",
    "build:notifications": "npm --prefix apps/notifications-service run build",
    "lint:notifications": "npm --prefix apps/notifications-service run lint",
    "typecheck:notifications": "npm --prefix apps/notifications-service run typecheck",
    "test:notifications": "npm --prefix apps/notifications-service test",
    "env:services:dev": "node scripts/generate-services-dev-env.mjs",
    "dev:services:up": "npm run env:services:dev && docker compose -f docker-compose.services.yml up -d --build",
    "dev:services:down": "docker compose -f docker-compose.services.yml down",
    "test:services:smoke": "node scripts/services-smoke.mjs",
    "test:unir:e2e": "node scripts/unir-e2e.mjs",
    "token:services": "node scripts/services-dev-token.mjs"
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.18"
  }
}
