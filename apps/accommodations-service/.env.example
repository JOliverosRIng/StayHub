NODE_ENV=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Internal port; the service refuses to start on any other value.
ACCOMMODATIONS_PORT=3003

# Only accommodations_db is accepted. Prefer the *_FILE variant with a secret file.
ACCOMMODATIONS_DATABASE_URL_FILE=./secrets/accommodations-database-url.txt
# ACCOMMODATIONS_DATABASE_URL=postgresql://accommodations:change-me@accommodations-db:5432/accommodations_db

# Access JWT verification (RS256). issuer, audience and kid are mandatory and must match
# the token issued by Auth. How the real public key / JWKS is delivered is pending G3 (ACC-003).
ACCOMMODATIONS_JWT_ISSUER=https://auth.stayhub.internal
ACCOMMODATIONS_JWT_AUDIENCE=stayhub-api
ACCOMMODATIONS_JWT_KID=stayhub-auth-2026-01
# Configure exactly one key source: a PEM public key (RSA >= 2048) or a local JWKS JSON that
# contains the configured kid. Private keys are rejected.
ACCOMMODATIONS_JWT_PUBLIC_KEY_FILE=./secrets/access-public.pem
# ACCOMMODATIONS_JWT_JWKS_FILE=./secrets/access-jwks.json

# Internal service JWT used by Bookings for the booking-quote snapshot.
ACCOMMODATIONS_SERVICE_JWT_ISSUER=stayhub-e2e-gateway
ACCOMMODATIONS_SERVICE_JWT_AUDIENCE=stayhub-e2e-accommodations-service
ACCOMMODATIONS_SERVICE_JWT_KID=accommodations-service
ACCOMMODATIONS_SERVICE_JWT_PUBLIC_KEY_FILE=./secrets/service-public.pem
# ACCOMMODATIONS_SERVICE_JWT_JWKS_FILE=./secrets/service-jwks.json
ACCOMMODATIONS_BOOKING_QUOTE_SCOPE=accommodations:booking-quote

# Absolute directory behind StoragePort (local volume). No public URL is generated in v1.
ACCOMMODATIONS_PHOTO_STORAGE_ROOT=/var/lib/stayhub/accommodations/photos

# Swagger UI is mounted at /docs only when NODE_ENV=development.
ACCOMMODATIONS_SWAGGER_SERVER_URL=/

# Test database only: disposable PostgreSQL 16 with database accommodations_db.
# Windows + Docker Desktop: use 127.0.0.1, not localhost.
ACCOMMODATIONS_TEST_DATABASE_URL=postgresql://accommodations:TEST_ONLY@127.0.0.1:55436/accommodations_db
