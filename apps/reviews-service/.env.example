NODE_ENV=development
REVIEWS_PORT=3007
REVIEWS_DATABASE_URL=postgresql://reviews:CHANGE_ME@reviews-db:5432/reviews_db?schema=public
REVIEWS_USER_JWT_PUBLIC_KEYS_JSON={"dev-key":"-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"}
REVIEWS_USER_JWT_ISSUER=stayhub-auth
REVIEWS_USER_JWT_AUDIENCE=stayhub-api
REVIEWS_GATEWAY_JWT_PUBLIC_KEYS_JSON={"dev-key":"-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"}
REVIEWS_GATEWAY_JWT_ISSUER=stayhub-gateway
REVIEWS_GATEWAY_JWT_AUDIENCE=stayhub-reviews-service
REVIEWS_GATEWAY_JWT_SCOPE=reviews:read
REVIEWS_BOOKINGS_BASE_URL=http://bookings-service:3005
REVIEWS_BOOKINGS_TIMEOUT_MS=1500
REVIEWS_BOOKINGS_SERVICE_TOKEN_FILE=/run/secrets/reviews_bookings_service_token
REVIEWS_SHUTDOWN_GRACE_MS=10000
REVIEWS_LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
