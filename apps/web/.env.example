# StayHub web (Vite). Copy to apps/web/.env.local for local overrides.
#
# Every VITE_* variable is embedded in the public JavaScript bundle.
# NEVER put tokens, passwords, private keys or credentialed URLs here.

# Gateway base URL used by the browser.
# - Development: keep the relative path; the Vite proxy forwards /api to WEB_GATEWAY_URL
#   (configured in the repository root .env, default http://127.0.0.1:8080).
# - Production builds: REQUIRED. Use a relative path (same origin) or an https:// URL.
#   `vite build` fails if it is missing or uses plain http://.
VITE_API_BASE_URL=/api/v1

# Contract mocks (MSW) for properties/search/reviews while the Gateway does not expose them.
# Only honoured by `vite dev`; production builds never include the mocks.
VITE_API_MOCKS=false
