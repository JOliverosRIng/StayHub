generator client {
  provider      = "prisma-client-js"
  output        = "../src/infrastructure/persistence/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("BOOKINGS_DATABASE_URL")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  PAYMENT_FAILED
  EXPIRED
  CANCELLED_BY_GUEST
  CANCELLED_BY_OWNER
}

enum PaymentStatus {
  NOT_STARTED
  ORDER_PENDING
  PENDING
  CAPTURED
  FAILED
  REVIEW_REQUIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  REFUND_FAILED
  REFUND_REVIEW_REQUIRED
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
  FAILED_RETRYABLE
}

enum PaymentOperation {
  CREATE_ORDER
  REQUEST_REFUND
}

enum WorkStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  FAILED_RETRYABLE
  DEAD
}

enum NotificationOperation {
  BOOKING_CONFIRMED
}

enum CancellationActor {
  GUEST
  OWNER
  SYSTEM
}

model Booking {
  id                    String                 @id @db.Uuid
  guestId               String                 @db.Uuid
  ownerId               String                 @db.Uuid
  propertyId            String                 @db.Uuid
  roomId                String                 @db.Uuid
  propertyName          String                 @db.VarChar(120)
  roomName              String                 @db.VarChar(120)
  checkIn               DateTime               @db.Date
  checkOut              DateTime               @db.Date
  guests                Int
  capacitySnapshot      Int
  nightlyPriceAmount    Decimal                @db.Decimal(12, 2)
  currency              String                 @db.Char(3)
  nights                Int
  totalAmount           Decimal                @db.Decimal(12, 2)
  accommodationVersion  Int
  roomSourceUpdatedAt   DateTime               @db.Timestamptz(6)
  status                BookingStatus
  paymentStatus         PaymentStatus          @default(ORDER_PENDING)
  paymentOrderId        String?                @unique @db.Uuid
  holdExpiresAt         DateTime?              @db.Timestamptz(6)
  cancellationPolicyVersion String?           @db.VarChar(80)
  cancelledBy           CancellationActor?
  cancellationReason    String?                @db.VarChar(500)
  cancelledAt           DateTime?              @db.Timestamptz(6)
  checkedInAt           DateTime?              @db.Timestamptz(6)
  checkedOutAt          DateTime?              @db.Timestamptz(6)
  version               Int                    @default(1)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  transitions           BookingTransition[]
  idempotencyRecords    IdempotencyRecord[]
  paymentWork           PaymentWork[]
  notificationWork      NotificationWork[]
  cancellationDecisions CancellationDecision[]

  @@index([guestId, createdAt, id])
  @@index([ownerId, createdAt, id])
  @@index([ownerId, status, checkIn, id])
  @@index([propertyId, checkIn, id])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

model BookingTransition {
  id         String         @id @db.Uuid
  bookingId  String         @db.Uuid
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorType  String         @db.VarChar(20)
  actorId    String?        @db.Uuid
  reasonCode String         @db.VarChar(80)
  metadata   Json
  occurredAt DateTime       @default(now()) @db.Timestamptz(6)

  @@index([bookingId, occurredAt, id])
  @@map("booking_transitions")
}

model IdempotencyRecord {
  guestId        String           @db.Uuid
  key            String           @db.VarChar(128)
  requestHash    String           @db.Char(64)
  bookingId      String?          @db.Uuid
  booking        Booking?         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  state          IdempotencyState
  responseStatus Int?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime         @db.Timestamptz(6)

  @@id([guestId, key])
  @@map("idempotency_records")
}

model PaymentWork {
  id             String           @id @db.Uuid
  bookingId      String           @db.Uuid
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  operation      PaymentOperation
  idempotencyKey String           @unique @db.VarChar(160)
  amount         Decimal          @db.Decimal(12, 2)
  currency       String           @db.Char(3)
  status         WorkStatus       @default(PENDING)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now()) @db.Timestamptz(6)
  lastErrorCode  String?          @db.VarChar(80)

  @@unique([bookingId, operation])
  @@index([status, nextAttemptAt])
  @@map("payment_work")
}

model NotificationWork {
  id            String                @id @db.Uuid
  bookingId     String                @db.Uuid
  booking       Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  operation     NotificationOperation @default(BOOKING_CONFIRMED)
  status        WorkStatus            @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now()) @db.Timestamptz(6)
  lastErrorCode String?               @db.VarChar(80)
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(6)

  @@unique([bookingId, operation])
  @@index([status, nextAttemptAt])
  @@map("notification_work")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  aggregateId   String    @db.Uuid
  eventType     String    @db.VarChar(120)
  schemaVersion Int       @default(1)
  payload       Json
  occurredAt    DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt   DateTime? @db.Timestamptz(6)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([publishedAt, nextAttemptAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @db.Uuid
  eventType   String   @db.VarChar(120)
  payloadHash String   @db.Char(64)
  processedAt DateTime @default(now()) @db.Timestamptz(6)
  outcome     String   @db.VarChar(40)

  @@map("processed_events")
}

model CancellationDecision {
  id            String   @id @db.Uuid
  bookingId     String   @db.Uuid
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  policyVersion String   @db.VarChar(80)
  actorType     String   @db.VarChar(20)
  eligible      Boolean
  refundMode    String   @db.VarChar(20)
  evaluatedAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([bookingId, evaluatedAt])
  @@map("cancellation_decisions")
}
