{
  "name": "@stayhub/bookings-service",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20 <21" },
  "scripts": {
    "build": "cd ../.. && nest build bookings-service",
    "start": "node ../../dist/apps/bookings-service/main.js",
    "start:dev": "cd ../.. && nest start bookings-service --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:contract": "jest --selectProjects contract --runInBand",
    "test:security": "jest --selectProjects security --runInBand",
    "test:concurrency": "jest --selectProjects concurrency --runInBand",
    "test:performance": "jest --selectProjects performance --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "node scripts/migrate-deploy.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0", "@opentelemetry/exporter-metrics-otlp-http": "0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2", "@opentelemetry/sdk-metrics": "1.30.1", "@opentelemetry/sdk-node": "0.57.2",
    "@nestjs/common": "10.4.22", "@nestjs/config": "3.3.0", "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22", "@nestjs/swagger": "8.1.1", "@prisma/client": "6.19.0",
    "amqplib": "0.10.9", "class-transformer": "0.5.1", "class-validator": "0.14.1",
    "jose": "5.9.6", "reflect-metadata": "0.2.2", "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1", "@nestjs/cli": "10.4.8", "@nestjs/testing": "10.4.22",
    "@types/amqplib": "0.10.7", "@types/express": "4.17.21", "@types/jest": "29.5.14",
    "@types/node": "20.17.19", "@types/supertest": "6.0.2", "ajv": "8.20.0", "ajv-formats": "3.0.1",
    "eslint": "9.20.1", "jest": "29.7.0", "prisma": "6.19.0", "supertest": "7.0.0",
    "ts-jest": "29.2.5", "ts-node": "10.9.2", "typescript": "5.7.3", "typescript-eslint": "8.24.0", "yaml": "2.8.1"
  }
}
