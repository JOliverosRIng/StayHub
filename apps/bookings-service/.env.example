NODE_ENV=development
BOOKINGS_PORT=3005
BOOKINGS_DATABASE_URL=postgresql://bookings:CHANGE_ME@bookings-db:5432/bookings_db?schema=public
BOOKINGS_SERVICE_JWT_PUBLIC_KEYS_JSON={"dev-key":"-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"}
BOOKINGS_SERVICE_JWT_ISSUER=stayhub-gateway
BOOKINGS_SERVICE_JWT_AUDIENCE=stayhub-bookings-service
BOOKINGS_SERVICE_JWT_SCOPE=bookings:invoke
# Internal Reviews consumer credentials (defaults shown when omitted).
BOOKINGS_REVIEWS_JWT_SCOPE=reviews:eligibility
BOOKINGS_REVIEWS_JWT_AUDIENCE=stayhub-bookings-service
BOOKINGS_ACCOMMODATIONS_URL=http://accommodations-service:3003
BOOKINGS_PAYMENTS_URL=http://payments-service:3006
BOOKINGS_NOTIFICATIONS_URL=http://notifications-service:3009
BOOKINGS_NOTIFICATIONS_JWT_AUDIENCE=stayhub-notifications-service
BOOKINGS_NOTIFICATIONS_JWT_SCOPE=notifications:send
BOOKINGS_NOTIFICATIONS_TIMEOUT_MS=3000
# Token dedicado para Notifications. Si se omite, se usa el token saliente genérico.
BOOKINGS_NOTIFICATIONS_SERVICE_TOKEN_FILE=/run/secrets/bookings_notifications_service_token
# Worker durable Bookings -> Notifications.
BOOKINGS_NOTIFICATION_WORK_POLL_INTERVAL_MS=5000
BOOKINGS_NOTIFICATION_WORK_BATCH_SIZE=10
BOOKINGS_NOTIFICATION_WORK_MAX_ATTEMPTS=8
BOOKINGS_NOTIFICATION_WORK_RETRY_BASE_MS=1000
BOOKINGS_NOTIFICATION_WORK_LEASE_MS=300000
# Workers de pago, expiración de holds y outbox.
BOOKINGS_WORKER_POLL_INTERVAL_MS=2000
BOOKINGS_WORKER_BATCH_SIZE=25
BOOKINGS_OUTBOX_BATCH_SIZE=50
# Solo desarrollo/pruebas contra la pasarela mock. Omitir para usar el token sintético estable por booking.
BOOKINGS_PAYMENTS_MOCK_TOKEN=
BOOKINGS_DEPENDENCY_TIMEOUT_MS=3000
BOOKINGS_PAYMENT_HOLD_MINUTES=15
BOOKINGS_CANCELLATION_POLICY_VERSION=test-only-v1
# Approved policy document only; values must be supplied by product and match the version above.
BOOKINGS_CANCELLATION_POLICY_JSON={"version":"test-only-v1","freeCancellationBeforeHours":48,"refundPercent":100}
BOOKINGS_RABBITMQ_URL=amqp://bookings:CHANGE_ME@rabbitmq:5672/stayhub
# Exchange de salida propio de Bookings (booking.v1.*).
BOOKINGS_RABBITMQ_EXCHANGE=stayhub.bookings.v1
# Exchange de entrada del productor Payments (payment.v1.* -> routing payment.*).
BOOKINGS_RABBITMQ_PAYMENTS_EXCHANGE=stayhub.payments
BOOKINGS_RABBITMQ_QUEUE=stayhub.bookings.payment-events.v1
BOOKINGS_RABBITMQ_RETRY_QUEUE=stayhub.bookings.payment-events.v1.retry
BOOKINGS_RABBITMQ_DLQ=stayhub.bookings.payment-events.v1.dlq
BOOKINGS_RABBITMQ_PREFETCH=10
BOOKINGS_RABBITMQ_MAX_RETRIES=3
# TTL de la cola de reintento antes de volver al exchange de Payments.
BOOKINGS_RABBITMQ_RETRY_DELAY_MS=5000
BOOKINGS_SHUTDOWN_GRACE_MS=10000
BOOKINGS_LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Supply one of these only for local service-to-service calls. Production should mount the token file.
BOOKINGS_OUTBOUND_SERVICE_TOKEN_FILE=/run/secrets/bookings_outbound_service_token
# Mapa opcional de tokens por audiencia/scope. Payments exige un scope exacto por operación.
# BOOKINGS_OUTBOUND_SERVICE_TOKENS_JSON={"payments-service:payments:charge":"<jwt>","payments-service:payments:refund":"<jwt>"}
