NODE_ENV=development
NOTIFICATIONS_PORT=3009
# Use a dedicated PostgreSQL database; never point this at users_db.
NOTIFICATIONS_DATABASE_URL=postgresql://notifications:REPLACE_ME@127.0.0.1:5432/notifications_db

# Access JWT issued by Auth; public key only.
NOTIFICATIONS_JWT_ISSUER=REPLACE_WITH_ACCESS_JWT_ISSUER
NOTIFICATIONS_JWT_AUDIENCE=REPLACE_WITH_ACCESS_JWT_AUDIENCE
NOTIFICATIONS_JWT_KID=REPLACE_WITH_ACCESS_JWT_KID
NOTIFICATIONS_JWT_PUBLIC_KEY_FILE=./secrets/access-public.pem

# Service JWT verifier. Auth/Gateway provisioning is an external integration dependency.
NOTIFICATIONS_SERVICE_JWT_ISSUER=REPLACE_WITH_SERVICE_JWT_ISSUER
NOTIFICATIONS_SERVICE_JWT_AUDIENCE=REPLACE_WITH_NOTIFICATIONS_AUDIENCE
NOTIFICATIONS_SERVICE_JWT_KID=REPLACE_WITH_SERVICE_JWT_KID
NOTIFICATIONS_SERVICE_JWT_PUBLIC_KEY_FILE=./secrets/service-public.pem
NOTIFICATIONS_SEND_SCOPE=notifications:send

# EMAIL defaults to a local simulated adapter. Set smtp to deliver real email.
NOTIFICATIONS_EMAIL_MODE=stub
# NOTIFICATIONS_SMTP_HOST=smtp.example.com
# NOTIFICATIONS_SMTP_PORT=587
# NOTIFICATIONS_SMTP_SECURE=false
# NOTIFICATIONS_SMTP_FROM=notifications@example.com
# NOTIFICATIONS_SMTP_USER=
# NOTIFICATIONS_SMTP_PASSWORD=
